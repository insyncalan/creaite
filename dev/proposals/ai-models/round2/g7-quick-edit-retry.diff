+def retry_plan(ctx, got, first_alias=None, settings=None):
+    """#132 G7: {"route", "prompt", "made_by"} for a quick edit's one retry, or None. Only when the check found a changed fact
+    (providers.retry_kind), the writing kind routes this text to a model stronger than the one that made the first suggestion,
+    and that model may be sent it: route_for with the same declaration as the first try (outside_route), G5's gate on the
+    answer (direct_call). Claude gets the prompt it always gets; another provider only edit_ai.outside_prompt. At the defaults
+    (quick edits and writing both on Claude Sonnet) there is no stronger model, so nothing is retried, as today."""
+    import providers
+    try:
+        settings = paths.load_settings() if settings is None else settings
+        if providers.retry_kind("quick", (got or {}).get("notes")) != "write" or ctx.get("retried"):
+            return None
+        _problems, routed = outside_route(ctx, "write", settings)
+        pick = str(routed["model"] or "")
+        first = ctx.get("made_by_id") or f"claude:{first_alias or 'sonnet'}"       # None: #126's Sonnet pin (NO_CONTEXT_ARGS)
+        new, old = providers.model(pick, settings), providers.model(first, settings)
+        if not new or not old or new["grade"] <= old["grade"]:
+            return None
+        if pick.startswith("claude:"):
+            alias = pick.partition(":")[2]
+            return {"route": {"alias": alias, "nested": True}, "prompt": ctx["prompt"], "made_by": new["label"]} \
+                if alias in CLAUDE_ALIASES else None
+        opener, made_by, prompt = direct_call(pick, routed, ctx, settings)
+    except Exception:  # noqa: BLE001  fails closed: no retry
+        return None
+    return {"route": {"direct": opener, "nested": True}, "prompt": prompt, "made_by": made_by}
