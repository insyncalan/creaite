+"""#132 G8 (proposal): Claude by API key, the live server's side. The key desk hands the Claude API key to creaite's key helper
+(keyhelper.py) when, and only when, Claude Code runs that helper for a run the live server started.
+
+How a run gets the key, and nothing else does:
+  - the live server opens the desk (a Unix socket in a private folder made for it, mode 0700) the first time a run starts with
+    Claude on an API key; at the default settings it is never opened;
+  - for each such run it issues a ticket (secrets.token_urlsafe(32)) kept in this process's memory only, and names the helper,
+    with the desk's path and the ticket, in the run's --settings `apiKeyHelper`. The ticket is not the key: it is a run's right
+    to ask, and it ends when the run ends (revoke);
+  - when a connection arrives the desk asks macOS (libproc and sysctl, through ctypes; no program is started) who is asking. It
+    answers the key only when the ticket is a live run's, the asking program is the helper itself (this server's Python, with
+    exactly `-I <keyhelper.py> <desk> <ticket>`), and it runs under that run's Claude Code (the process this server started for
+    the run; a run whose number isn't known yet, the VIP check's, is bound to the first Claude Code under this server that asks).
+    A ticket gives the key at most MAX_GIVEN times, and at most BURST times a minute (Claude Code asks at the start, every five
+    minutes and after a 401);
+  - the key is read from the key store (G1, the keychain) at that moment and sent on the socket only. It is never in an
+    environment variable, a command line, a file, a log line or an answer to anything else. The log gets the run's id and
+    what happened, never a key or a ticket.
+
+A model run can't ask: the guard hook refuses running keyhelper.py and keydesk.py in every mode, the wrapper refuses them, no
+permission rule may name them (reach.py, permissions.py), and a Bash call runs only creaite scripts. A program that isn't the
+helper, or isn't under the run, is refused even with the ticket.
+"""
+import hmac
+import os
+import re
+import secrets
+import shlex
+import socket
+import struct
+import sys
+import tempfile
+import threading
+import time
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+import paths  # noqa: E402,F401  (doctor: every script imports paths)
+
+HELPER = Path(__file__).resolve().parent / "keyhelper.py"
+TICKET = re.compile(rb"T ([A-Za-z0-9_-]{43})\n?")
+MAX_GIVEN = 12                       # answers per run at most (a 30-minute run asks about seven times)
+BURST = 3                            # answers per run within a minute at most
+HOPS = 4                             # helper → (sh) → Claude Code: how far up the desk looks for the run's Claude Code
+WORDS = {                            # what the helper prints on stderr (printable ASCII, never a key); Claude Code shows it
+    "form": "creaite's key helper asked in a way the desk doesn't take.",
+    "ticket": "This run's key ticket isn't valid: the run has ended, or creaite didn't start it.",
+    "helper": "Only creaite's key helper, started by Claude Code, may ask for the key.",
+    "run": "The key helper wasn't started by this run's Claude Code.",
+    "many": "This run has asked for the key too often.",
+    "nokey": "No Claude API key is kept for this vault: connect one in Settings > AI models.",
+    "keychain": "The keychain didn't give creaite the key: unlock your Mac and try again.",
+}
+
+
+class Peer:
+    """Who is on the other end of a desk connection, from macOS itself (ctypes; no program is started): the process number,
+    its parent, its program file and its arguments."""
+
+    _lib = None
+
+    @classmethod
+    def lib(cls):
+        """libSystem, with proc_pidinfo, proc_pidpath and sysctl typed."""
+        if cls._lib is None:
+            import ctypes
+            lib = ctypes.CDLL("/usr/lib/libSystem.B.dylib")
+            vp, ci = ctypes.c_void_p, ctypes.c_int
+            lib.proc_pidinfo.restype, lib.proc_pidinfo.argtypes = ci, [ci, ci, ctypes.c_uint64, vp, ci]
+            lib.proc_pidpath.restype, lib.proc_pidpath.argtypes = ci, [ci, vp, ctypes.c_uint32]
+            lib.sysctl.restype = ci
+            lib.sysctl.argtypes = [ctypes.POINTER(ci), ctypes.c_uint, vp, ctypes.POINTER(ctypes.c_size_t), vp, ctypes.c_size_t]
+            cls._lib = lib
+        return cls._lib
+
+    def pid(self, conn):
+        """The connecting process's number (getsockopt SOL_LOCAL, LOCAL_PEERPID)."""
+        return struct.unpack("i", conn.getsockopt(0, 0x002, 4))[0]
+
+    def parent(self, pid):
+        """The parent's number (proc_pidinfo PROC_PIDTBSDINFO: pbi_ppid), or None."""
+        import ctypes
+        buf = ctypes.create_string_buffer(136)
+        if self.lib().proc_pidinfo(pid, 3, 0, buf, 136) != 136:
+            return None
+        return struct.unpack_from("I", buf.raw, 16)[0]
+
+    def path(self, pid):
+        """The process's program file (proc_pidpath), or None."""
+        import ctypes
+        buf = ctypes.create_string_buffer(4096)
+        return buf.value.decode("utf-8", "replace") if self.lib().proc_pidpath(pid, buf, 4096) > 0 else None
+
+    def argv(self, pid):
+        """The process's arguments (sysctl KERN_PROCARGS2), or []."""
+        import ctypes
+        mib, size = (ctypes.c_int * 3)(1, 49, pid), ctypes.c_size_t(0)
+        if self.lib().sysctl(mib, 3, None, ctypes.byref(size), None, 0) != 0 or not size.value:
+            return []
+        buf = ctypes.create_string_buffer(size.value)
+        if self.lib().sysctl(mib, 3, buf, ctypes.byref(size), None, 0) != 0:
+            return []
+        raw = buf.raw[:size.value]
+        argc, rest = struct.unpack_from("i", raw)[0], raw[4:]
+        i = rest.find(b"\0")                                  # the program's path, then padding
+        while 0 <= i < len(rest) and rest[i] == 0:
+            i += 1
+        return [p.decode("utf-8", "replace") for p in rest[i:].split(b"\0")[:argc]] if i > 0 else []
+
+
+class KeyDesk:
+    """The desk: tickets for runs, and the key for the helper of a live run. `read_key()` answers the Claude key or None (it
+    may raise: a keychain that says no)."""
+
+    def __init__(self, read_key, peer=None, log=None, now=time.monotonic, server_pid=None):
+        self.read_key, self.peer, self.log, self.now = read_key, peer or Peer(), log or (lambda line: None), now
+        self.server_pid = server_pid or os.getpid()
+        self.path, self.sock, self.own, self.tickets, self.lock = None, None, None, {}, threading.Lock()
+
+    # ── Opening and closing ──
+    def start(self):
+        """Open the desk once (a socket in a new private folder) and answer on a thread; its path."""
+        with self.lock:
+            if self.path:
+                return self.path
+            folder = tempfile.mkdtemp(prefix="creaite-kd-")
+            os.chmod(folder, 0o700)
+            path = os.path.join(folder, "desk")
+            s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
+            s.bind(path)
+            os.chmod(path, 0o600)
+            s.listen(8)
+            self.sock, self.path, self.own = s, path, self.peer.path(os.getpid())
+        threading.Thread(target=self._serve, daemon=True).start()
+        return path
+
+    def stop(self):
+        """Close the desk and forget every ticket (the server stops)."""
+        with self.lock:
+            self.tickets.clear()
+            sock, path, self.sock, self.path = self.sock, self.path, None, None
+        if sock:
+            sock.close()
+        for p in ((path, os.path.dirname(path)) if path else ()):
+            try:
+                os.remove(p) if p == path else os.rmdir(p)
+            except OSError:
+                pass                                           # already gone: nothing to tidy
+
+    # ── Tickets ──
+    def issue(self, run_id):
+        """A new ticket for a run (replacing any earlier one)."""
+        t = secrets.token_urlsafe(32)
+        with self.lock:
+            self.tickets[run_id] = {"value": t, "pid": None, "given": []}
+        return t
+
+    def bind(self, run_id, pid):
+        """The run's Claude Code is process `pid`. A ticket already used by another process is ended."""
+        with self.lock:
+            t = self.tickets.get(run_id)
+            if t and t["pid"] not in (None, pid):
+                self.tickets.pop(run_id, None)
+                self.log(f"{run_id} key ticket ended: used outside its run")
+            elif t:
+                t["pid"] = pid
+
+    def revoke(self, run_id):
+        """The run has ended: its ticket goes."""
+        with self.lock:
+            self.tickets.pop(run_id, None)
+
+    def command(self, ticket):
+        """The apiKeyHelper command for a run: this server's Python, isolated, the helper, the desk and the ticket."""
+        return " ".join(shlex.quote(x) for x in (sys.executable, "-I", str(HELPER), self.path, ticket))
+
+    # ── Answering ──
+    def _serve(self):
+        sock = self.sock
+        while sock is not None and self.sock is sock:
+            try:
+                conn, _ = sock.accept()
+            except OSError:
+                return                                         # the desk was closed
+            threading.Thread(target=self._one, args=(conn,), daemon=True).start()
+
+    def _one(self, conn):
+        try:
+            conn.settimeout(2)
+            conn.sendall(self.answer(conn.recv(200), conn))
+        except OSError:
+            pass                                               # the helper went away: Claude Code reports it
+        finally:
+            conn.close()
+
+    def answer(self, line, conn):
+        """The bytes the helper gets: b"KEY <key>\\n", or b"NO <words>\\n"."""
+        run_id, why = self.check(line, conn)
+        if not why:
+            try:
+                key = self.read_key()
+                why = "" if key else "nokey"
+            except Exception:  # noqa: BLE001  a keychain that says no (G1's KeychainError): words, never details
+                key, why = None, "keychain"
+        if why:
+            self.log(f"{run_id or '-'} key helper refused: {why}")
+            return b"NO " + WORDS[why].encode("ascii") + b"\n"
+        self.log(f"{run_id} key given to its Claude Code")
+        return b"KEY " + key.encode("ascii") + b"\n"
+
+    def check(self, line, conn):
+        """(run id or None, why not or "") for one request."""
+        m = TICKET.fullmatch(line or b"")
+        if not m:
+            return None, "form"
+        with self.lock:
+            run_id, t = self._find(m.group(1).decode("ascii"))
+            if t is None:
+                return None, "ticket"
+            pid = self.peer.pid(conn)
+            if not self._is_helper(pid, t["value"]):
+                return run_id, "helper"
+            claude = self._under(pid, t["pid"])
+            if claude is None:
+                return run_id, "run"
+            now = self.now()
+            if len(t["given"]) >= MAX_GIVEN or sum(1 for g in t["given"] if now - g < 60) >= BURST:
+                return run_id, "many"
+            t["pid"] = claude
+            t["given"].append(now)
+        return run_id, ""
+
+    def _find(self, value):
+        """(run id, ticket) for a ticket value, compared in constant time; (None, None)."""
+        found = (None, None)
+        for run_id, t in self.tickets.items():
+            if hmac.compare_digest(t["value"], value):
+                found = (run_id, t)
+        return found
+
+    def _is_helper(self, pid, ticket):
+        """Whether process `pid` is the helper itself: this server's Python running exactly `-I keyhelper.py <desk> <ticket>`."""
+        return self.peer.path(pid) == self.own and self.peer.argv(pid)[1:] == ["-I", str(HELPER), self.path, ticket]
+
+    def _under(self, pid, bound):
+        """The run's Claude Code above `pid` (within HOPS): `bound` when the ticket is bound, else the first ancestor this server
+        started; None when there is none."""
+        p = pid
+        for _ in range(HOPS):
+            p = self.peer.parent(p)
+            if not p or p <= 1:
+                return None
+            if bound is not None and p == bound:
+                return p
+            if bound is None and self.peer.parent(p) == self.server_pid:
+                return p
+        return None
