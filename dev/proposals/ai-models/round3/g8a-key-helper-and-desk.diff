@@ -0,0 +1,69 @@
+"""creaite's Claude API key helper (#132 G8): Claude Code runs this to get the Claude API key for one run, and nothing else does.
+
+Claude Code's `apiKeyHelper` setting names a shell command that prints an API key on stdout; Claude Code runs it itself (outside
+any tool call), keeps what it prints in its own memory and sends it to Anthropic. The live server names this script, in the
+--settings of a run it starts with Claude on an API key, with two arguments: the path of the live server's key desk (a Unix socket
+in a private folder) and that run's ticket (random, held in the live server's memory, good only while that run lasts).
+
+This script has no key and can't read the keychain. It sends the ticket to the desk and prints what the desk answers: the key, on
+stdout only, for Claude Code to read. The desk answers only when the ticket is a live run's, the program asking is this script
+(its program and arguments) and it was started under that run's Claude Code (keydesk.py).
+
+It runs isolated (`python -I`): standard library only, no creaite module, no environment variable read. It writes no file and no
+log. When the desk says no, or isn't there, it prints plain words on stderr (never a key) and exits 1: Claude Code then says the
+helper failed and the run stops.
+
+Never run by hand, by a model run or through system/scripts/run: reach.py and permissions.py refuse it by name.
+"""
+import re
+import socket
+import sys
+
+TICKET = re.compile(r"[A-Za-z0-9_-]{43}")                  # secrets.token_urlsafe(32)
+KEY = re.compile(rb"[A-Za-z0-9._~+/=:-]{8,400}")            # providers.KEY_CHARS: what an API key is made of
+WORDS = re.compile(rb"[ -~]{1,200}")                        # the desk's refusal: printable ASCII, one short line
+TIMEOUT = 10                                                # seconds for the desk to answer
+NOT_HERE = "creaite's key helper is run only by Claude Code, in a run the live server started."
+
+
+def say(words):
+    """Plain words on stderr (never a key) and exit status 1."""
+    sys.stderr.write(words + "\n")
+    return 1
+
+
+def ask(path, ticket):
+    """The desk's answer to this ticket: at most 1 KB, or raises OSError."""
+    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
+        s.settimeout(TIMEOUT)
+        s.connect(path)
+        s.sendall(b"T " + ticket.encode("ascii") + b"\n")
+        data = b""
+        while len(data) < 1024:
+            part = s.recv(1024 - len(data))
+            if not part:
+                break
+            data += part
+    return data
+
+
+def main(argv):
+    """Print the run's key on stdout (exit 0), or plain words on stderr (exit 1)."""
+    if len(argv) != 3 or not argv[1].startswith("/") or not TICKET.fullmatch(argv[2]):
+        return say(NOT_HERE)
+    try:
+        data = ask(argv[1], argv[2])
+    except OSError:
+        return say("The live server didn't answer creaite's key helper: is it still running?")
+    head, _, rest = data.strip().partition(b" ")
+    if head == b"KEY" and KEY.fullmatch(rest):
+        sys.stdout.write(rest.decode("ascii"))
+        sys.stdout.flush()
+        return 0
+    if head == b"NO" and WORDS.fullmatch(rest):
+        return say(rest.decode("ascii"))
+    return say("The live server's key desk gave no usable answer.")
+
+
+if __name__ == "__main__":
+    sys.exit(main(sys.argv))
