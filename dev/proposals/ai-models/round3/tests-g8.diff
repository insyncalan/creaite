+            self.assertEqual(out["set_aside"], {}, what)
+            self.assertEqual(out["limit"], {}, what)
+            self.assertIn("apiKeyHelper", out["next"]["settings"], f"{what}: the next run is on the key")
+
+    def test_a_key_source_other_than_the_helper_adds_a_step(self):
+        out = self.outcome("elsewhere")
+        self.assertTrue(any("didn't use your API key" in e.get("label", "") for e in out["events"]))
