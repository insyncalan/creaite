+    def test_the_vip_check_on_the_key(self):
+        out = self.go(r'''
+import subprocess, sweep
+sweep.vip_settings = lambda: {"enabled": True}
+sweep.vip_addresses = lambda: ["mia.hale@example.com"]
+L.sweep_running = lambda: False
