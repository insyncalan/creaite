+class Guard(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        cls.root = S.vault3()
+
+    def test_a_model_run_never_runs_the_helper_or_the_desk(self):
+        out = S.run_py(self.root, r'''
+import reach
+cmds = ["system/scripts/run keyhelper.py desk " + "A" * 43, "python3 system/scripts/keyhelper.py",
+        "python3 -I system/scripts/keyhelper.py desk " + "A" * 43, "system/scripts/run keydesk.py",
+        "python3 system/scripts/keydesk.py"]
+modes = [("ask", False), ("confirmed", False), ("sweep", False), ("sweep", True), ("prep", False), ("held", False)]
+res = {f"{m}{h} {c}": list(reach.decide("Bash", {"command": c}, m, "", h)) for c in cmds for m, h in modes}
+print(json.dumps({"res": res, "wrap": [reach.wrap_problem(["keyhelper.py"]), reach.wrap_problem(["keydesk.py", "x"])]}))''')
+        for k, (allow, why) in out["res"].items():
+            self.assertFalse(allow, k)
+            if " -I " not in k:                                     # refused by name, not because the file is missing
+                self.assertIn("only the live server uses", why, k)
+        self.assertTrue(all("only the live server uses" in w for w in out["wrap"]), out["wrap"])
+
+    def test_no_permission_rule_or_settings_change_reaches_the_helper(self):
+        out = S.run_py(self.root, r'''
+import permissions as P
+rules = ["Bash(system/scripts/run keyhelper.py *)", "Bash(python3 -I system/scripts/keyhelper.py *)",
+         "Bash(system/scripts/run keydesk.py)", "Read(/private/var/folders/**/creaite-kd-*/**)", "Bash(echo apiKeyHelper)"]
+before = {"permissions": {"allow": []}}
+after = {"permissions": {"allow": []}, "apiKeyHelper": "/bin/sh -c 'echo x'"}
+print(json.dumps({"rules": {r: P.rule_refusal(r) for r in rules}, "ok": P.rule_refusal("Bash(system/scripts/run doctor.py)"),
+                  "file": P.settings_problem("claude", before, after)}))''')
+        for r, why in out["rules"].items():
+            self.assertTrue(why, r)
+        self.assertIsNone(out["ok"])
+        self.assertIn("apiKeyHelper", out["file"])
+
+    def test_the_never_list_and_the_hook_settings_do_not_move(self):
+        code = r'''
+import reach, live_server as L
+print(json.dumps({"never": [list(x) for x in reach.NEVER], "hook": L.guard_settings("r-x", "ask"),
+                  "held": L.guard_settings("r-x", "held", True)}).replace(str(__import__("paths").ROOT), "<VAULT>"))'''
+        self.assertEqual(S.run_py(self.root, code), S.run_py(S.vault3(patched=False), code))
+
+    def test_doctor_still_finds_every_script_importing_paths(self):
+        out = S.run_py(self.root, "import doctor\nprint(json.dumps(doctor.scripts_use_paths()))")
+        self.assertNotIn("keyhelper.py", out[1])                 # it runs isolated: doctor knows
+        self.assertNotIn("keydesk.py", out[1])
