+def fake_run(cmd, **kw):
+    calls.append({"cmd": cmd, "env": {k: v for k, v in kw["env"].items() if k.startswith("ANTHROPIC")}})
+    return subprocess.CompletedProcess(cmd, 1, json.dumps({"type": "result", "is_error": True,
