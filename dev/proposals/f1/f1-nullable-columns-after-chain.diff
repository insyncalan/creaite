+def engine_version():
+    """F1: the installed creaite version (VERSION in the vault root), or None when it can't be read."""
+    try:
+        return (paths.ROOT / "VERSION").read_text(encoding="utf-8").strip() or None
+    except OSError:
+        return None
+
+
+def stamp_apply(con, apply_id):
+    """F1: record the engine version on an apply row. Does nothing on a database that has not been migrated yet
+    (the column is missing), so an older database keeps working until `tracker.py migrate` runs."""
+    if "engine_version" in columns(con, "applies"):
+        con.execute("UPDATE applies SET engine_version = ? WHERE apply_id = ?", (engine_version(), apply_id))
+
