+PANEL_CALENDAR_WORDS = re.compile(r"(?:please )?refresh (?:the |my )?calendar(?: now)?(?: please)?[.!]?", re.I)
+
+
+def panel_calendar(message, images=(), confirmed=None):
+    """#339 A: True when a panel request is only "refresh calendar" (the sweep's own words for it): it runs as the small
+    "calendar" kind (#265), not as a sweep. Words only, never the model; an image or a confirmed request is never one."""
+    text = " ".join(str(message or "").split())
+    return not (images or confirmed) and len(text) <= 60 and bool(PANEL_CALENDAR_WORDS.fullmatch(text))
+
+
 def panel_sweep(message, images=(), confirmed=None):
     """True when a panel request is a plain sweep (BL-309): cx-sweep's own words and nothing more. A thread's subject may not
     carry another instruction ("and", "then", apply, approve…); an image or a confirmed request is never a sweep."""
