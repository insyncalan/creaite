 # ===== end BL-228 =====
 
+
+# ===== #371 (v2.6.9): what a run started with =====
+def init_summary(ev):
+    """One line of counts from a stream-json system init event (None for any other event): the servers by status, whether the
+    Microsoft 365 connector is connected (its name is never logged, nor any other server's) and how many of the run's tools
+    are Microsoft 365 tools. Pure; no title, text or user data."""
+    if not isinstance(ev, dict) or ev.get("subtype") != "init":
+        return None
+    by_status, m365 = {}, "absent"
+    for srv in ev.get("mcp_servers") or []:
+        if not isinstance(srv, dict):
+            continue
+        status = str(srv.get("status") or "unknown")[:20]
+        by_status[status] = by_status.get(status, 0) + 1
+        if "microsoft" in str(srv.get("name") or "").lower():
+            m365 = status
+    tools = [t for t in ev.get("tools") or [] if isinstance(t, str)]
+    n365 = sum(1 for t in tools if "microsoft" in t.lower() and t.startswith("mcp__"))
+    servers = ", ".join(f"{k} {v}" for k, v in sorted(by_status.items())) or "none"
+    return f"mcp servers: {servers}; microsoft365: {m365}; m365 tools: {n365} of {len(tools)} tools"
+# ===== end #371 =====
