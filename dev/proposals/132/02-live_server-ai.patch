+class _Lines:
+    """A pipe's readline for DirectProcess: the lines put, then "" once closed."""
+
+    def __init__(self):
+        import queue
+        self.q = queue.Queue()
+
+    def put(self, line):
+        """One line of the stream."""
+        self.q.put(line + "\n")
+
+    def close(self):
+        """The end of the stream."""
+        self.q.put("")
+
+    def readline(self):
+        """The next line, or "" at the end."""
+        return self.q.get()
