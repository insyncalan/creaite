+// @ts-check
+/* F2: compare two item IDs by their prefix, then by their NUMBER, so ABC-A-999 sorts before ABC-A-1000 (a text compare puts it after). */
+/** @param {string} s @returns {[string, number]} */
+const idKey = s => { const m = /^(.*?)(\d+)$/.exec(String(s || "")); return m ? [m[1], +m[2]] : [String(s || ""), 0]; };
+/** @param {string} a @param {string} b */
+export const idCmp = (a, b) => { const x = idKey(a), y = idKey(b); return x[0].localeCompare(y[0]) || x[1] - y[1] || String(a).localeCompare(String(b)); };
