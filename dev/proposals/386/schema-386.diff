+-- People (#386): everyone who is named on an item. tracker.py writes it (item ops on table "people") and exports
+-- projects/_portfolio/people-register.md from it after each apply. Who Alan follows is never here (BL-288: it stays in
+-- system/staging/people-private.json). aliases, labels, projects_add and projects_remove are JSON lists of text; a person's
+-- projects are those of their items, plus projects_add, minus projects_remove (Alan, 27-10-2026). needs_details is 1 while the
+-- email, organisation or role is missing (kept by tracker.py).
+CREATE TABLE IF NOT EXISTS people (
+  id              INTEGER PRIMARY KEY AUTOINCREMENT,
+  name            TEXT NOT NULL COLLATE NOCASE UNIQUE CHECK (length(name) BETWEEN 1 AND 200 AND name = trim(name)
+                                                           AND instr(name, '|') = 0 AND instr(name, char(10)) = 0),
+  email           TEXT,
+  aliases         TEXT NOT NULL DEFAULT '[]' CHECK (aliases GLOB '[[]*[]]'),
+  organisation    TEXT,
+  role            TEXT,
+  is_group        INTEGER NOT NULL DEFAULT 0 CHECK (is_group IN (0,1)),
+  hidden          INTEGER NOT NULL DEFAULT 0 CHECK (hidden IN (0,1)),
+  labels          TEXT NOT NULL DEFAULT '[]' CHECK (labels GLOB '[[]*[]]'),
+  projects_add    TEXT NOT NULL DEFAULT '[]' CHECK (projects_add GLOB '[[]*[]]'),
+  projects_remove TEXT NOT NULL DEFAULT '[]' CHECK (projects_remove GLOB '[[]*[]]'),
+  needs_details   INTEGER NOT NULL DEFAULT 1 CHECK (needs_details IN (0,1)),
+  created         TEXT NOT NULL CHECK (created GLOB '[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]'),
+  updated_at      TEXT NOT NULL DEFAULT (datetime('now'))
+);
+
 CREATE TABLE IF NOT EXISTS updates (
