+def _person(con, key, what="person"):
+    row = fetch(con, "people", key) if key not in (None, "") else None
+    if row is None:
+        raise Invalid(f"{what} {key!r} is not in the people table")
+    return dict(row)
+
+
+def _add_person(con, item, apply_id, via):
+    return write_item(con, {**item, "op": "new"}, apply_id, via)
+
+
+def _rename_person(con, item, apply_id, via):
+    if set(item.get("changes") or {}) != {"name"}:
+        raise Invalid("a rename changes the name only (changes: {\"name\": …})")
+    return write_item(con, {**item, "op": "update"}, apply_id, via)
+
+
+def _merge_person(con, item, apply_id, via):
+    """`id` goes into `into`: their name and aliases become aliases of `into`, their email, organisation and role fill its gaps,
+    their lists join its lists, their row goes and every item naming them names `into`. One undo puts all of it back."""
+    src = _person(con, item.get("id"))
+    dest = _person(con, item.get("into"), "into")
+    if src["id"] == dest["id"]:
+        raise Invalid("a person can't be merged into themselves")
+    changes = {f: src[f] for f in ("email", "organisation", "role") if not str(dest[f] or "").strip() and str(src[f] or "").strip()}
+    aliases = [a for a in json_list(dest["aliases"]) + [src["name"]] + json_list(src["aliases"]) if fold(a) != fold(dest["name"])]
+    joined = {"aliases": aliases, **{f: json_list(dest[f]) + json_list(src[f]) for f in PERSON_LISTS[1:]}}
