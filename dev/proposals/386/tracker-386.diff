+def carry_person_name(con, old, new, apply_id, via):
+    """Every item naming `old` (in any case or Unicode form, in any of the seven name columns) names `new` instead, each change
+    logged. Matched in Python (fold), not by SQLite's NOCASE, which folds only A to Z."""
+    want = fold(old)
+    for t, c in PERSON_COLUMNS:
+        for r in con.execute(f"SELECT id, {c}, updated_at FROM {t} WHERE {c} IS NOT NULL").fetchall():
+            if r[1] == new or fold(r[1]) != want:
+                continue
+            at = now()
+            con.execute(f"UPDATE {t} SET {c} = ?, updated_at = ? WHERE id = ?", (new, at, r[0]))
+            log(con, apply_id, t, r[0], c, r[1], new, "update", via)
+            log(con, apply_id, t, r[0], "updated_at", r[2], at, "update", via)
+
+
+def _carry_person_rename(con, current, diff, apply_id, via):
