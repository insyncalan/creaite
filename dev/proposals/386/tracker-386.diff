+def add_named_people(con, table, key, apply_id, via):
+    """After an item is written: each name on it that is no one's name or alias becomes a person, needs_details 1, in the same
+    apply (only once the people table is in use). A name that can't be a person (TBC, a bar, a line break) is left alone."""
+    cols = [c for t, c in PERSON_COLUMNS if t == table]
+    if not cols or not people_live(con):
+        return key
+    row = fetch(con, table, key)
+    known = person_names(con) if row is not None else {}
+    for c in cols if row is not None else ():
+        name = str(row[c] or "").strip()
+        if fold(name) in NOT_A_PERSON or fold(name) in known or name_problem(name):
+            continue
+        write_item(con, {"op": "new", "table": "people", "values": {"name": name}}, apply_id, via)
+        known[fold(name)] = name
+    return key
+
