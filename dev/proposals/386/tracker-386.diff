+def register_export_text(con):
+    """The people register as creaite writes it: a note, then one People table the existing readers parse. No Follow or Hidden
+    column: both are slice 2's private file's."""
+    rows = [join_cells(EXPORT_COLUMNS), "|" + "|".join("-" * (len(c) + 2) for c in EXPORT_COLUMNS) + "|"]
+    for p in con.execute("SELECT * FROM people ORDER BY name COLLATE NOCASE, id"):
+        rows.append(join_cells([p["name"], p["email"], ", ".join(json_list(p["aliases"])), p["organisation"], p["role"],
+                                ", ".join(json_list(p["labels"])), "yes" if p["is_group"] else "",
+                                ", ".join(json_list(p["projects_add"])), ", ".join(json_list(p["projects_remove"]))]))
+    return "\n".join(["# People register", "", EXPORT_NOTE, "", "## People", "", *rows]) + "\n"
+
+
+def join_cells(cells):
+    """One row of the register's People table."""
+    return "| " + " | ".join(_cell(c) for c in cells) + " |"
+
+
+def _people_state():
+    try:
+        return json.loads((paths.STAGING / PEOPLE_STATE).read_text(encoding="utf-8"))
+    except (OSError, ValueError):            # no export yet (or a damaged state file): nothing to compare a hand edit with
+        return {}
+
+
+def _keep_register(folder, stem):
+    """A copy of the register as it is now, in `folder` under a free name; its stored path."""
+    folder.mkdir(parents=True, exist_ok=True)
+    kept = paths.free_path(folder, stem, ".md")
+    shutil.copy2(paths.PEOPLE_REGISTER, kept)
+    return kept
+
+
+def export_people(con, first=False):
+    """Write the register from the people table, when it holds anyone. A register changed since creaite last wrote it (a hand
+    edit) is kept aside first (system/backups/files/), and recorded for Health; with no earlier export it is kept as
+    system/backups/people-register.before-386.md. `first`: the move's own export, which kept the old register itself (so a move
+    run again after an Undo is never a hand edit). Returns None when there is nothing to export, else
+    {"path", "hash", "written", "kept", "hand_edit"}."""
+    if not people_live(con):
+        return None
+    text = register_export_text(con)
+    p, state = paths.PEOPLE_REGISTER, _people_state()
+    cur = p.read_bytes() if p.is_file() else None
+    changed = cur != text.encode("utf-8")
+    kept, hand = None, False
+    if cur is not None and changed and not first and hashlib.sha256(cur).hexdigest() != state.get("sha256"):
+        hand = bool(state.get("sha256"))
+        kept = _keep_register(paths.BACKUPS / "files", f"people-register-hand-edit-{datetime.now():%Y-%m-%d-%H%M%S}") if hand \
+            else _keep_register(paths.BACKUPS, PEOPLE_BEFORE[:-3])
+        if hand:
+            state["hand_edit"] = {"at": now(), "kept": paths.rel(kept)}
+            print(f"Note: the people register was edited by hand; that copy is kept as {paths.rel(kept)} and the register is made "
+                  "from your project record again (edit people in Settings › People).")
+            debuglog.warn("tracker", f"people register: hand edit kept as {paths.rel(kept)}")
+    if changed:
+        p.parent.mkdir(parents=True, exist_ok=True)
+        paths.write_text_atomic(p, text)
+    state.update(sha256=hashlib.sha256(text.encode("utf-8")).hexdigest(), at=now())
+    paths.STAGING.mkdir(parents=True, exist_ok=True)
+    paths.write_text_atomic(paths.STAGING / PEOPLE_STATE, json.dumps(state, indent=2) + "\n")
+    return {"path": paths.rel(p), "hash": file_hash(p), "written": changed, "kept": paths.rel(kept) if kept else None,
+            "hand_edit": hand}
+
+
+def export_people_quietly():
+    """export_people after an apply or undo; a failure is noted and never fails the save."""
+    from contextlib import closing
+    try:
+        if paths.DB.exists():
+            with closing(connect()) as con:
+                export_people(con)
+    except Exception as e:  # noqa: BLE001
+        debuglog.exception("tracker", "people export failed")
+        print(f"Note: the people register wasn't written: {type(e).__name__}")
+
+
+def _reverse_people_register(rec, report):
+    """Undo of migrate-people: the register file as it was before the move (the copy the move kept)."""
+    p = paths.resolve(rec["path"])
+    kept = paths.resolve(rec["kept"]) if rec.get("kept") else None
+    now_hash = file_hash(p)
+    if kept is not None and now_hash == file_hash(kept):
+        return                                   # the export never landed: the old register is still there
+    if now_hash is not None and now_hash != rec["hash"]:
+        report.append(f"skipped {rec['path']}: changed since")
+    elif kept is not None:
+        shutil.copy2(kept, p)
+    else:
+        p.unlink(missing_ok=True)
+
+
+REVERSE_MORE["people-register"] = _reverse_people_register
+
+
+# ---------- migrate-people: the register file becomes the table, once ----------
+def private_moved():
+    """Whether slice 2's one-time move of who is followed and hidden has run: people_private.moved() (its file says when, or its
+    tombstone does). Read the same way here while people_private.py isn't installed."""
+    try:
+        import people_private
+    except ImportError:
+        people_private = None
+    if people_private is not None:
+        return bool(people_private.moved())
+    try:
+        moved = json.loads((paths.STAGING / "people-private.json").read_text(encoding="utf-8")).get("moved")
+    except (OSError, ValueError, AttributeError):     # no private file, or not one: not moved (unless the tombstone says so)
+        moved = None
+    return bool(moved) or (paths.STAGING / "people-private.json.moved").is_file()
+
+
+PRIVATE_LEFT = "private"
+
+
+def _row_loss(cols, cells, moved):
+    """What the move couldn't carry from one People row (reasons without names)."""
+    why = []
+    if len(cells) > len(cols) and any(cells[len(cols):]):
+        why.append("a row has more cells than the header")
+    row = dict(zip(cols, cells + [""] * len(cols)))
+    if not row.get("Full name", "").strip() and any(cells):
+        why.append("a row has no full name")
+    for c, v in ((c, v.strip()) for c, v in row.items() if v.strip()):
+        if c == "Group" and fold(v) not in YES + NO:
+            why.append("a Group value isn't yes or blank")
+        elif c in PRIVATE_COLUMNS and fold(v) not in NO and not moved:
+            why.append(PRIVATE_LEFT)
+        elif c not in EXPORT_COLUMNS and c not in PRIVATE_COLUMNS:
+            why.append(f"its {c or 'unnamed'} column has values")
+    return why
+
+
+def register_loss(text, moved):
+    """What the move couldn't carry from the register text, as reasons without names ([] when it carries everything). It carries
+    the People table's rows in the export's columns; the Follow, VIP and Hidden columns are slice 2's (empty, or already moved into
+    its private file: `moved`, then their values are its); the template's guidance lines are replaced by the export's note.
+    Anything else (another column with values, another section or table, a free note, a row with no name or longer than the
+    header, a table without the line under its header) is never dropped: the move refuses instead."""
+    import propose
+    lines = text.splitlines()
+    found = propose.people_table(lines)
+    why, table_at = [], set()
+    if found:
+        head, rows_at = found
+        table_at = {head, head + 1, *rows_at}
+        cols = propose.split_row(lines[head])
+        if "Full name" not in cols or len(set(cols)) != len(cols):
+            why.append("its People table has no Full name column, or two columns with one name")
+        if head + 1 >= len(lines) or not SEPARATOR.fullmatch(lines[head + 1].strip()):
+            why.append("its People table has no line under the header")
+        for i in rows_at:
+            why += _row_loss(cols, propose.split_row(lines[i]), moved)
+        if rows_at and not propose.people_parse(text):
+            why.append("no one in its People table can be read")
+    for i, line in enumerate(lines):
+        s = line.strip()
+        if i not in table_at and s and s not in REGISTER_HEADINGS and not s.startswith(REGISTER_GUIDE):
+            why.append("it has text outside the People table (a note, another section or another table)")
+            break
+    return list(dict.fromkeys(why))
+
+
+def pending_register_write():
+    """The file name of a staged proposal that still writes the people register (an old-style edit from the page or propose.py,
+    not yet applied or rejected), or None: after the move that write would stop every full apply."""
+    for p in sorted(paths.STAGING.glob("proposed-*.json")):
+        try:
+            data = json.loads(p.read_text(encoding="utf-8"))
+        except (OSError, ValueError):            # an unreadable proposal can't be applied either: it writes nothing
+            continue
+        for blk, field in blocks(data) if isinstance(data, dict) else ():
+            if blk.get("applied") or blk.get(field) == "rejected":
+                continue
+            for fop in blk.get("file_ops") or []:
+                if isinstance(fop, dict) and fop.get("op") == "write" and _writes_register(fop.get("path")):
+                    return p.name
+    return None
+
+
+def _writes_register(rel):
+    try:
+        return bool(rel) and is_people_register(paths.resolve(rel).resolve())
+    except (OSError, ValueError, RuntimeError):     # a path that can't be resolved can't be the register
+        return False
+
+
+def register_problems(rows):
+    """The register's ambiguities, which the move never guesses: two rows with one name, or a name or alias that is two people's."""
+    rows_of = {}
+    for i, r in enumerate(rows):
+        for x in [r["name"]] + list(r.get("aliases") or []):
+            rows_of.setdefault(fold(x), (x, set()))[1].add(i)
+    return [f"“{x}” is the name or alias of {len(at)} rows" for x, at in rows_of.values() if len(at) > 1]
+
+
+def _person_from_row(r):
+    x = r.get("extra") or {}
+    split = lambda v: [c.strip() for c in str(v or "").split(",") if c.strip()]   # noqa: E731
+    return {"name": r["name"], "email": r.get("email") or None, "aliases": r.get("aliases") or [], "organisation": r.get("org") or None,
+            "role": r.get("role") or None, "is_group": 1 if fold(x.get("Group")) in YES else 0, "labels": r.get("labels") or [],
+            "projects_add": split(x.get("Projects")), "projects_remove": split(x.get("Left projects"))}
+
+
+def item_people_names(con):
+    """Every name in the seven name columns, as first written, in a stable order."""
+    out = {}
+    for t, c in PERSON_COLUMNS:
+        for (v,) in con.execute(f"SELECT trim({c}) FROM {t} WHERE trim(COALESCE({c}, '')) <> '' ORDER BY id"):
+            if fold(v) not in NOT_A_PERSON and not name_problem(v):
+                out.setdefault(fold(v), v)
+    ident = str((paths.load_settings().get("identity") or {}).get("name") or "").strip()
+    if ident and not name_problem(ident):
+        out.setdefault(fold(ident), ident)       # Alan is in the export (Alan, 27-10-2026)
+    return list(out.values())
+
+
+def _migration_refusal(text, rows):
+    """Why the register can't be moved as it is, or None: a register edit still waiting in Review, who is followed or hidden still
+    only in the register, something the move can't carry, or an ambiguity."""
+    pending = pending_register_write()
+    if pending:
+        return (f"People not moved: a change to the people register is still waiting in Review ({pending}). Apply or reject it "
+                "first, then move people.")
+    loss = register_loss(text, private_moved()) if text is not None else []
+    if PRIVATE_LEFT in loss:
+        return ("People not moved: who you follow or hide is still only in the register. Move it to its private file first "
+                "(Settings › Health), so it isn't lost.")
+    if loss:
+        return "\n  ".join(["People not moved: the register holds something the move can't carry, and creaite never drops "
+                            "anything. Change it in the register first, then move people:", *loss])
+    problems = register_problems(rows)
+    if problems:
+        return "\n  ".join(["People not moved: the register is ambiguous, and creaite never guesses. Fix these in Settings › People "
+                            "first:", *problems])
+    return None
+
+
+def _write_migration(con, rows, extra):
+    """The register's rows and the names from items as people, in one apply, with the register's own record (the copy kept, the
+    export's hash) written before the COMMIT, so Undo puts the old register back even if the export then fails. Its apply_id, or
+    None (nothing written)."""
+    try:
+        con.execute("BEGIN IMMEDIATE")
+        apply_id = con.execute("INSERT INTO applies (at, proposals, file_ops) VALUES (?, ?, ?)", (now(), "[]", "[]")).lastrowid
+        for values in [_person_from_row(r) for r in rows] + [{"name": n} for n in extra]:
+            try:
+                write_item(con, {"op": "new", "table": "people", "values": values}, apply_id, PEOPLE_VIA)
+            except Invalid as e:
+                raise Invalid(f"{values['name']}: {e}") from e
+        text = register_export_text(con)
+        kept = paths.rel(_keep_register(paths.BACKUPS, PEOPLE_BEFORE[:-3])) if paths.PEOPLE_REGISTER.is_file() else None
+        rec = {"op": "people-register", "path": paths.rel(paths.PEOPLE_REGISTER),
+               "hash": hashlib.sha256(text.encode("utf-8")).hexdigest(), "kept": kept}
+        con.execute("UPDATE applies SET file_ops = ? WHERE apply_id = ?", (json.dumps([rec]), apply_id))
+        con.execute("COMMIT")
+        return apply_id
+    except (Invalid, sqlite3.Error, OSError) as e:
+        if con.in_transaction:
+            con.execute("ROLLBACK")
+        print(f"People not moved; nothing was written. {e}")
+        return None
+
+
+def cmd_migrate_people(args):
+    """Move the people register into the people table as one apply: every row in the export's columns (Projects and Left projects
+    become projects_add and projects_remove, Group is_group), then each name on an item, and Alan, that is no one's name or alias
+    (needs_details 1). Then the register is made from the table. Stops, changing nothing, while a register edit waits in Review,
+    while who is followed or hidden is still only in the register, on anything it can't carry, and on an ambiguity. Run again it
+    only adds new names from items. --dry-run prints counts only, and writes nothing."""
+    try:
+        return _migrate_people("--dry-run" in args)
+    except sqlite3.OperationalError as e:
+        busy = "locked" in str(e) or "busy" in str(e)
+        print("People not moved; nothing was written. " + ("The record is busy (another save is running): try again in a minute."
+                                                            if busy else f"The record can't be read ({type(e).__name__})."))
+        return 1
+
+
+def _register_now(con):
+    """(text, why) of the register before the move: its text (None when there is none, or once the table is in use) and why it
+    can't be read, or None."""
+    if people_live(con) or not paths.PEOPLE_REGISTER.is_file():
+        return None, None
+    try:
+        return paths.PEOPLE_REGISTER.read_text(encoding="utf-8"), None
+    except (OSError, ValueError):
+        return None, "People not moved; nothing was written. The people register can't be read."
+
+
+def _first_export(con):
+    """The move's own export, right after its COMMIT; a failure is noted (the next save writes it, and Undo still works)."""
+    try:
+        return export_people(con, first=True)
+    except OSError as e:
+        debuglog.exception("tracker", "migrate-people: the first export failed")
+        print(f"Note: the people register wasn't written yet ({type(e).__name__}); it is written at your next save, and "
+              "Undo still puts the old one back.")
+        return None
+
+
+def _to_move(con):
+    """(the register's rows, the names from items that are no one's, why the move can't run or None)."""
+    text, why = _register_now(con)
+    import propose                               # lazily: propose imports tracker
+    rows = propose.people_parse(text) if text else []
+    why = why or (None if people_live(con) else _migration_refusal(text, rows))
+    known = {fold(x) for r in rows for x in [r["name"]] + list(r.get("aliases") or [])} | set(person_names(con))
+    return rows, [n for n in item_people_names(con) if fold(n) not in known], why
+
+
+def _migrate_people(dry):
+    from contextlib import closing
+    with closing(connect()) as con:
+        if not people_table_exists(con):
+            print("There is no people table yet: bring the record up to date first (say \"repair creaite\").")
+            return 1
+        rows, extra, why = _to_move(con)
+        if why:
+            print(why)
+            return 1
+        if dry or not (rows or extra):
+            print(f"People to move: {len(rows)} from the register, {len(extra)} from items (needs details)."
+                  + (" Nothing written." if dry else " Nothing to do."))
+            return 0
+        backup = backup_db("migrate-people")
+        apply_id = _write_migration(con, rows, extra)
+        if apply_id is None:
+            return 1
+        out = _first_export(con)
+    debuglog.info("tracker", f"migrate-people: apply {apply_id}, {len(rows)} from the register, {len(extra)} from items; "
+                             f"backup {paths.rel(backup)}")
+    print(f"People moved (save {apply_id}): {len(rows)} from the register, {len(extra)} from items (needs details). "
+          "The register is now made from your project record"
+          + (f"; the old one is kept as {out['kept']}." if (out or {}).get("kept") else "."))
+    after_apply()
+    return 0
+# ===== end #386 slice 3 =====
+
