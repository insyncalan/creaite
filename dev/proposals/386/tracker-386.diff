+# ===== #386 slice 3: the people table and its one writer =====
+# Item ops on table "people" (schema.sql): "new" (or "add") with `values`, "update" with `changes`, "rename" (`changes`: {"name"})
+# and "merge" (`id` into `into`). A person's key is their row id. Every write is logged in change_log, so undo reverses it. A
+# rename or merge carries the name across all seven name columns in the same apply; a name an apply writes into one of them that is
+# no one's name or alias is added as a person with needs_details 1. Once the table holds anyone, the register file is made from it
+# after every apply and undo (export_people). Who Alan follows and who is hidden are never in the table, its change_log rows or the
+# export (BL-288; Jarvis, 27-10-2026): both stay in slice 2's private file, system/staging/people-private.json.
+AUTO_KEY = ("people",)                       # tables whose key is the rowid SQLite gives
+PERSON_COLUMNS = (("actions", "owner"), ("raid", "owner"), ("decisions", "made_by"), ("promises", "promised_by"),
+                  ("promises", "promised_to"), ("milestones", "owner"), ("workstreams", "lead"))
+PERSON_LISTS = ("aliases", "labels", "projects_add", "projects_remove")
+PERSON_FLAGS = ("is_group", "needs_details")
+PERSON_TEXT = ("organisation", "role")       # one register cell each: no bar, no line break
+NOT_A_PERSON = ("", "tbc", "tbd", "unknown", "n/a", "none")
+PEOPLE_VIA = "migrate-people"
+PEOPLE_STATE = "people-export.json"          # in system/staging/: the sha256 of the register creaite last wrote; the last hand edit
+PEOPLE_BEFORE = "people-register.before-386.md"     # in system/backups/: the register as it was before the first export
+# The export's columns; the move carries exactly these from the register. client_leak reads the file's Aliases cell by its
+# position (the third): keep "Aliases" third.
+EXPORT_COLUMNS = ("Full name", "Email", "Aliases", "Organisation", "Role", "Labels", "Group", "Projects", "Left projects")
+PRIVATE_COLUMNS = ("Follow", "VIP", "Hidden")       # slice 2's: moved into its private file by its own move, never into the record
+REGISTER_HEADINGS = ("# People register", "## People", "Notes:")
+REGISTER_GUIDE = ("Keep this file at `projects/_portfolio/people-register.md`", "- **Full name:**", "- **Email:**",
+                  "- **Aliases:**", "- **Organisation and Role:**", "- **Hidden:**", "- **Follow:**", "- **VIP:**",
+                  "- **Labels (BL-94):**", "- Use no `|` characters inside a cell.")   # the template's lines: the export's note replaces them
+YES, NO = ("yes", "y", "true", "1"), ("", "no", "n", "false", "0", "-")
+SEPARATOR = re.compile(r"\|?\s*:?-+:?\s*(\|\s*:?-+:?\s*)*\|?")
+EXPORT_NOTE = ("Made by creaite from your project record: edit people in Settings › People, or with cx-edit. creaite writes "
+               "this file again after every save; a change made here by hand is kept aside in system/backups/files/ and replaced.")
+EMAIL_RE = re.compile(r"[^@\s,;|]+@[^@\s,;|]+")
+
+
+def fold(text):
+    """A name as compared: NFC, spaces collapsed, case-folded, so "ÉLODIE", "élodie" and a decomposed "élodie" are one name."""
+    import unicodedata
+    return " ".join(unicodedata.normalize("NFC", str(text or "")).split()).casefold()
+
+
+def people_table_exists(con):
+    """True when tracker.db has the people table (schema.sql #386)."""
+    return con.execute("SELECT 1 FROM sqlite_master WHERE type = 'table' AND name = 'people'").fetchone() is not None
+
+
+def people_live(con):
+    """True once the people table holds anyone: until then the register file is still the record (not migrated yet)."""
+    return people_table_exists(con) and con.execute("SELECT 1 FROM people LIMIT 1").fetchone() is not None
+
+
+def register_is_made():
+    """True when the register file is made from the people table (so a proposal's write of it would be overwritten)."""
+    if not paths.DB.exists():
+        return False
+    from contextlib import closing
+    with closing(connect()) as con:
+        return people_live(con)
+
+
+def is_people_register(p):
+    """Whether a resolved path is the people register, whatever its case or Unicode form (macOS's disk ignores both)."""
+    return _folded(p) == _folded(paths.PEOPLE_REGISTER.resolve())
+
+
+def json_list(v, field="list"):
+    """A JSON list of text (or a Python list) as a clean list: trimmed, no blanks, each once whatever its case."""
+    if v is None or v == "":
+        return []
+    if isinstance(v, str):
+        try:
+            v = json.loads(v)
+        except ValueError:
+            raise Invalid(f"{field} must be a list") from None
+    if not isinstance(v, list) or not all(isinstance(x, str) for x in v):
+        raise Invalid(f"{field} must be a list of text")
+    out, seen = [], set()
+    for x in (x.strip() for x in v):
+        if x and fold(x) not in seen:
+            seen.add(fold(x))
+            out.append(x)
+    return out
+
+
+def broken_cell(text):
+    """True when `text` holds a bar or a line break (any control, line or paragraph separator): it can't be one register cell."""
+    import unicodedata
+    return "|" in text or any(unicodedata.category(c) in ("Cc", "Zl", "Zp") for c in text)
+
+
+def name_problem(name):
+    """Why `name` can't be a person's name or alias, or None."""
+    if not name:
+        return "a person needs a name"
+    if len(name) > 200:
+        return "a name is at most 200 characters"
+    if broken_cell(name):
+        return "a name can't hold a bar or a line break"
+    return None
+
+
+def details_missing(row):
+    """1 while the person's email, organisation or role is missing, else 0."""
+    return 0 if all(str(row.get(f) or "").strip() for f in ("email", "organisation", "role")) else 1
+
+
+def _person_values(values):
+    """In place: the name trimmed, the lists as JSON text, the flags as 0 or 1."""
+    if "name" in values:
+        values["name"] = str(values["name"] or "").strip()
+    for f in PERSON_LISTS:
+        if f in values:
+            values[f] = json.dumps(json_list(values[f], f), ensure_ascii=False)
+    for f in PERSON_FLAGS:
+        if f in values and values[f] not in (0, 1, True, False):
+            raise Invalid(f"{f} must be 0 or 1")
+        if f in values:
+            values[f] = int(values[f])
+
+
+def _new_person(values, via):
+    if "id" in values:
+        raise Invalid("a new person carries no id; creaite gives them one")
+    _person_values(values)
+    values.setdefault("created", today())
+    values["needs_details"] = details_missing(values)
+
+
+def _prepare_person(changes, current):
+    _person_values(changes)
+
+
+def _derive_person(row, current, changes):
+    row["needs_details"] = details_missing(row)
+
+
+def _person_cells(row):
+    """A person's email is addresses, and their organisation and role each fit one register cell."""
+    for f in PERSON_TEXT:
+        if broken_cell(str(row.get(f) or "")):
+            raise Invalid(f"{f} can't hold a bar or a line break")
+    for e in re.split(r"[,;]", str(row.get("email") or "")):
+        if e.strip() and not EMAIL_RE.fullmatch(e.strip()):
+            raise Invalid(f"{e.strip()!r} isn't an email address")
+
+
+def _person_fields(row):
+    """A person's name, email, organisation, role and lists each keep their own rules; returns the name and the aliases."""
+    name = str(row.get("name") or "").strip()
+    why = name_problem(name)
+    if why:
+        raise Invalid(why)
+    _person_cells(row)
+    for f in PERSON_LISTS:
+        for x in json_list(row.get(f), f):
+            if name_problem(x) or "," in x:
+                raise Invalid(f"{f}: {x!r} can't hold a comma, a bar or a line break")
+            if f.startswith("projects") and not re.fullmatch(CODE_RE, x):
+                raise Invalid(f"{f}: {x!r} isn't a project code")
+    aliases = json_list(row.get("aliases"))
+    placeholder = next((x for x in [name] + aliases if fold(x) in NOT_A_PERSON), None)
+    if placeholder:
+        raise Invalid(f"“{placeholder}” isn't a person's name: leave the owner for later instead")
+    return name, aliases
+
+
+def _person_known_values(con, row, changed):
+    """The labels and project codes being written name a label and a project you have (as the item writer's labels do)."""
+    if "labels" in changed:
+        canonical_labels(con, json_list(row.get("labels")))
+    for f in ("projects_add", "projects_remove"):
+        for code in json_list(row.get(f)) if f in changed else ():
+            if con.execute("SELECT 1 FROM projects WHERE code = ?", (code,)).fetchone() is None:
+                raise Invalid(f"{f}: {code} isn't one of your projects")
+
+
+def _person_rules(con, table, row, changed):
+    """A person's fields, and no name or alias shared with anyone else (never guessed between two people)."""
+    name, aliases = _person_fields(row)
+    _person_known_values(con, row, changed)
+    mine = [name] + aliases
+    if any(fold(a) == fold(name) for a in aliases):
+        raise Invalid(f"{name} can't be their own alias")
+    for other, o_aliases in con.execute("SELECT name, aliases FROM people WHERE id IS NOT ?", (row.get("id"),)).fetchall():
+        theirs = {fold(x) for x in [other] + json_list(o_aliases)}
+        hit = next((x for x in mine if fold(x) in theirs), None)
+        if hit:
+            raise Invalid(f"“{hit}” is already {other}'s name or alias: merge the two people, or use another name")
+
+
+NEW_HOOKS["people"] = _new_person
+UPDATE_PREPARE["people"] = _prepare_person
+DERIVE["people"] = _derive_person
+ROW_RULES["people"] = (_person_rules,)
