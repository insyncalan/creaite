+def person_names(con):
+    """{name or alias, folded: the person's name}."""
+    out = {}
+    for name, aliases in con.execute("SELECT name, aliases FROM people ORDER BY id"):
+        for x in [name] + json_list(aliases):
+            out.setdefault(fold(x), name)
+    return out
