+def _recode_people(con, old, new):
+    """A recode: a person's added and left projects follow the project's new code."""
+    if not people_table_exists(con):
+        return
+    for pid, *lists in con.execute("SELECT id, projects_add, projects_remove FROM people").fetchall():
+        moved = [json.dumps([new if c == old else c for c in json_list(v)], ensure_ascii=False) for v in lists]
+        if moved != [json.dumps(json_list(v), ensure_ascii=False) for v in lists]:
+            con.execute("UPDATE people SET projects_add = ?, projects_remove = ? WHERE id = ?", (*moved, pid))
