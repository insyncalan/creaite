+def _copy_bases():
+    """(the folder a stored path is built on, its real path) for the vault and, if set, the projects root; the longest first."""
+    bases = [(paths.ROOT, Path(os.path.realpath(paths.ROOT)))]
+    if paths.external():
+        bases.append((paths.projects_root(), Path(os.path.realpath(paths.projects_root()))))
+    return sorted(bases, key=lambda b: -len(b[0].parts))
+
+
+def open_copy_source(stored):
+    """#269 round 2 delta (LOW 1): open a copy's source for reading; (fd, stat), or raises Invalid. The stored path is relative
+    with no `..` part; it is opened one folder at a time from the vault or the projects root (the real folder), never following a
+    link on the way (O_NOFOLLOW at every step, so a parent folder that is or becomes a link fails, whenever it is swapped), and
+    the file must be a regular file with one link (a second hard link may be a file outside the vault). The caller closes fd."""
+    s = str(stored or "").replace("\\", "/")
+    if not s or Path(s).is_absolute() or re.match(r"^[A-Za-z]:", s) or ".." in s.split("/"):
+        raise Invalid(f"copy: the source must be a path in the vault or the projects folder, with no '..' ({stored!r})")
+    p = paths.resolve(s)
+    base = next(((b, real) for b, real in _copy_bases() if b in p.parents), None)
+    if base is None:
+        raise Invalid(f"copy: the source is outside the vault and the projects folder ({stored!r})")
+    parts, fd = p.relative_to(base[0]).parts, None
+    try:
+        fd = os.open(str(base[1]), os.O_RDONLY | getattr(os, "O_DIRECTORY", 0))
+        for part in parts[:-1]:
+            nxt = os.open(part, os.O_RDONLY | getattr(os, "O_DIRECTORY", 0) | os.O_NOFOLLOW, dir_fd=fd)
+            os.close(fd)
+            fd = nxt
+        f = os.open(parts[-1], os.O_RDONLY | os.O_NOFOLLOW | getattr(os, "O_NONBLOCK", 0), dir_fd=fd)
+    except FileNotFoundError:
+        raise Invalid(f"copy: source not found ({stored})") from None
+    except OSError:
+        raise Invalid(f"copy: the source is a link, or is under one ({stored}); only a plain file in the vault is filed") from None
+    finally:
+        if fd is not None:
+            os.close(fd)
+    st = os.fstat(f)
+    if not stat.S_ISREG(st.st_mode) or st.st_nlink != 1:
+        os.close(f)
+        raise Invalid(f"copy: the source is not a plain file, or has another hard link ({stored}); only a plain file is filed")
+    return f, st
+
