-    blks = [(b, f) for b, f in blocks(data) if not b.get("applied") and b.get(f) in ("approved", "rejected")]
+    blks = [(b, f) for b, f in blocks(data) if not b.get("applied") and b.get(f) in ("approved", "rejected")
+            and not by_others_waiting(data, b)]
     return items, blks
 
 
