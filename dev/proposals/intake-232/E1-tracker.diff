+def _copy_checked(src, dst, sha):
+    """#232 E1: someone else's minutes are copied from the bytes read once, never through a link, and only if they are the staged ones."""
+    with os.fdopen(os.open(src, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0)), "rb") as f:
+        data = f.read()
+    if hashlib.sha256(data).hexdigest() != sha:
+        raise Invalid(f"copy: {paths.rel(src)}: the file changed since it was staged")
+    dst.write_bytes(data)
+    shutil.copystat(src, dst)
+
