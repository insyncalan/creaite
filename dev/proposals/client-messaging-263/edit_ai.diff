+def _edit_ai_document_and_field(req, body):
+    """Copy the request's `document` (#123: a small object of strings) and `field` (#263: a field whose text goes to a client, text of
+    at most 40 characters; edit_ai.client_field checks it) into `body`; False for either when it isn't that shape."""
+    d = req.get("document")
