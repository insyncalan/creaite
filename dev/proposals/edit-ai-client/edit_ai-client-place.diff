+# unassigned U+2065 among the invisible operators.
+SHOWN_AS_NOTHING = frozenset([0x034F, 0x115F, 0x2065, 0x1160, 0x17B4, 0x17B5, 0x180B, 0x180C, 0x180D, 0x180F, 0x3164, 0xFFA0]
