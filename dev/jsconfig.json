{
  "compilerOptions": {
    "noEmit": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "allowJs": true,
    "checkJs": true,
    "strict": false,
    "skipLibCheck": true,
    "types": [],
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "paths": {
      "preact": [
        "../system/templates/vendor/preact/preact/src/index.d.ts"
      ],
      "preact/hooks": [
        "../system/templates/vendor/preact/preact/hooks/src/index.d.ts"
      ],
      "preact/jsx-runtime": [
        "../system/templates/vendor/preact/preact/jsx-runtime/src/index.d.ts"
      ],
      "@preact/signals": [
        "../system/templates/vendor/preact/signals/dist/signals.d.ts"
      ],
      "@preact/signals-core": [
        "../system/templates/vendor/preact/signals-core/dist/signals-core.d.ts"
      ]
    }
  },
  "include": [
    "../system/templates/dashboard/src/**/*.js",
    "../system/templates/dashboard/src/**/*.jsx",
    "types/**/*.d.ts"
  ]
}
