"""Ask creaite's permission requests (BL-75): the live server's side and the panel's card in headless Chrome.

Run: python3 dev/tests/test_permission_panel.py   (the Chrome part needs Google Chrome; skipped otherwise)
The server runs in a throwaway vault with a stand-in `claude` (CREAITE_CLAUDE) that prints Claude Code's stream-json
format, so no real Claude call is made.
"""
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time
import unittest
import urllib.error
import urllib.request
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from test_dashboard import CHROME, populate  # noqa: E402
from test_live_server import free_port  # noqa: E402
from test_tracker import Vault  # noqa: E402

FAKE_CLAUDE = r'''#!/usr/bin/env python3
import json, sys
args = sys.argv[1:]
message = args[args.index("-p") + 1]
allowed = args[args.index("--allowedTools") + 1].split(",")
disallowed = args[args.index("--disallowedTools") + 1].split(",")
system = args[args.index("--append-system-prompt") + 1]
out = lambda o: print(json.dumps(o), flush=True)
out({"type": "system", "subtype": "init", "session_id": "sess-perm-1"})
result = {"type": "result", "session_id": "sess-perm-1"}
if "echo flags" in message:
    text = "FLAGS " + json.dumps({"allowed": allowed, "disallowed": disallowed,
                                  "prompt": [w for w in ("PERMISSION:", "cx-document", "CONFIRM:", "/tmp") if w in system]})
elif "need permission" in message:
    text = "I can't save the summaries yet.\nPERMISSION: Write(system/search/**) | to save search summaries"
elif "need edit" in message:
    text = ("I'll add the rule.\nPERMISSION-EDIT: settings add allow Write(inbox/notes/**) | to keep notes in the inbox")
elif "two edits" in message:
    text = ("Two changes.\nPERMISSION-EDIT: settings add allow Write(inbox/notes/**) | to keep notes in the inbox\n"
            "PERMISSION-EDIT: config set sweep.due_from \"06:30\" | Alan wants the sweep earlier")
elif "bad edit" in message:
    text = "PERMISSION-EDIT: settings add allow Write(*) | everything"
elif "bad permission" in message:
    text = "PERMISSION: Bash(node build.js) | to build the document"
elif "already allowed" in message:
    text = "PERMISSION: Bash(python3 system/scripts/report.py adhoc *) | to build"
elif "was refused" in message:
    text = "That failed."
    result["permission_denials"] = [{"tool_name": "Write", "tool_input": {"file_path": "/tmp/build.js"}}]
elif "make a document" in message:
    text = "I'd build the register.\nCONFIRM: Build the actions register | Writes a Word draft in system/staging/drafts/"
else:
    text = "Done."
out({"type": "assistant", "message": {"content": [{"type": "text", "text": text}]}})
out({**result, "result": text})
'''


def events(resp):
    out = []
    for raw in resp:
        line = raw.decode().strip()
        if line.startswith("data: "):
            out.append(json.loads(line[6:]))
    return out


class PermissionPanelTests(unittest.TestCase):
    @classmethod
    def setUpClass(cls):
        cls.v = v = Vault()
        populate(v)
        fake = v.root / "fake_claude.py"
        fake.write_text(FAKE_CLAUDE)
        fake.chmod(0o755)
        cls.port = free_port()
        cls.base = f"http://127.0.0.1:{cls.port}"
        cls.env = {**os.environ, "CREAITE_PORT": str(cls.port), "CREAITE_CLAUDE": str(fake)}
        cls.proc = subprocess.Popen([sys.executable, str(v.root / "system/scripts/live_server.py")], env=cls.env,
                                    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        for _ in range(50):
            try:
                urllib.request.urlopen(cls.base + "/health", timeout=1)
                break
            except OSError:
                time.sleep(0.1)
        html = urllib.request.urlopen(cls.base + "/").read().decode()
        cls.token = json.loads(re.search(r'id="data">(.*?)</script>', html, re.S).group(1).replace("<\\/", "</"))["token"]
        cls.settings = v.root / ".claude/settings.json"
        cls.original = cls.settings.read_text(encoding="utf-8")

    @classmethod
    def tearDownClass(cls):
        cls.proc.terminate()
        cls.proc.wait(timeout=10)
        cls.v.cleanup()

    def setUp(self):
        self.settings.write_text(self.original, encoding="utf-8")
        for f in ("system/config/permissions-log.jsonl", "system/config/settings-log.jsonl"):
            (self.v.root / f).unlink(missing_ok=True)

    def post(self, path, body):
        req = urllib.request.Request(self.base + path, data=json.dumps(body).encode(), method="POST",
                                     headers={"Content-Type": "application/json", "X-Creaite-Token": self.token})
        try:
            with urllib.request.urlopen(req, timeout=60) as r:
                return r.status, json.loads(r.read())
        except urllib.error.HTTPError as e:
            return e.code, json.loads(e.read() or b"{}")

    def ask(self, message, **extra):
        req = urllib.request.Request(self.base + "/api/ask", data=json.dumps({"message": message, **extra}).encode(), method="POST",
                                     headers={"Content-Type": "application/json", "X-Creaite-Token": self.token})
        with urllib.request.urlopen(req, timeout=60) as r:
            return events(r)

    def allow(self):
        return json.loads(self.settings.read_text(encoding="utf-8"))["permissions"]["allow"]

    def test_a_run_asks_for_a_rule_and_the_panel_is_told_exactly_which(self):
        ev = self.ask("need permission")
        perm = next(e for e in ev if e["type"] == "permission")
        self.assertEqual((perm["rule"], perm["why"], perm["ok"], perm["reason"]),
                         ("Write(system/search/**)", "to save search summaries", True, ""))
        shown = " ".join(e["text"] for e in ev if e["type"] == "text")
        self.assertIn("I can't save the summaries yet.", shown)
        self.assertNotIn("PERMISSION", shown)                                                  # the protocol line isn't chat text
        self.assertEqual(self.allow(), json.loads(self.original)["permissions"]["allow"])      # asking changes nothing

    def test_a_rule_creaite_wont_add_is_explained_and_cant_be_applied(self):
        perm = next(e for e in self.ask("bad permission") if e["type"] == "permission")
        self.assertEqual((perm["ok"], perm["rule"]), (False, "Bash(node build.js)"))
        self.assertIn("must run one creaite script", perm["reason"])
        r = self.post("/api/permissions/apply", {"rule": "Bash(node build.js)"})[1]
        self.assertFalse(r["ok"])
        perm = next(e for e in self.ask("already allowed") if e["type"] == "permission")
        self.assertEqual((perm["ok"], perm["covered"]), (False, "Bash(python3 system/scripts/report.py *)"))
        self.assertNotIn("Bash(node build.js)", self.allow())

    def test_approving_applies_it_once_with_a_backup_and_a_log(self):
        self.ask("need permission")
        s, r = self.post("/api/permissions/apply", {"rule": "Write(system/search/**)"})
        self.assertTrue(r["ok"], r)
        self.assertEqual(self.allow()[-1], "Write(system/search/**)")
        self.assertEqual(len(list((self.v.root / "system/backups").glob("claude-settings-*.json"))), 1)
        entry = json.loads((self.v.root / "system/config/permissions-log.jsonl").read_text().splitlines()[-1])
        self.assertEqual((entry["via"], entry["why"]), ("dashboard", "to save search summaries"))   # the run's reason, not the page's
        again = self.post("/api/permissions/apply", {"rule": "Write(system/search/**)"})[1]
        self.assertFalse(again["ok"])                                                           # one approval, one change
        self.assertEqual(self.allow().count("Write(system/search/**)"), 1)

    def test_the_page_cannot_apply_a_rule_no_run_asked_for(self):
        r = self.post("/api/permissions/apply", {"rule": "Write(inbox/notes/**)"})[1]            # a fine rule, but nobody asked
        self.assertFalse(r["ok"])
        self.assertIn("Nothing asked for that rule", r["message"])
        self.assertEqual(self.allow(), json.loads(self.original)["permissions"]["allow"])
        self.assertEqual(self.post("/api/permissions/apply", {})[1]["ok"], False)

    def test_undo_takes_it_out(self):
        self.ask("need permission")
        self.post("/api/permissions/apply", {"rule": "Write(system/search/**)"})
        r = self.post("/api/permissions/undo", {})[1]
        self.assertTrue(r["ok"], r)
        self.assertNotIn("Write(system/search/**)", self.allow())
        self.assertIn("Nothing to undo", self.post("/api/permissions/undo", {})[1]["message"])

    def test_a_permission_file_edit_is_its_own_card_and_applies_once(self):
        ev = self.ask("need edit")
        pe = next(e for e in ev if e["type"] == "permission_edit")
        self.assertEqual((pe["ok"], pe["edit"], pe["why"]), (True, "settings add allow Write(inbox/notes/**)", "to keep notes in the inbox"))
        self.assertEqual(pe["summary"], "Add Write(inbox/notes/**) to .claude/settings.json › permissions.allow")
        self.assertNotIn("PERMISSION", " ".join(e["text"] for e in ev if e["type"] == "text"))
        self.assertEqual(self.allow(), json.loads(self.original)["permissions"]["allow"])        # asking changes nothing
        r = self.post("/api/permissions/edit", {"edit": pe["edit"]})[1]
        self.assertTrue(r["ok"], r)
        self.assertEqual(self.allow()[-1], "Write(inbox/notes/**)")
        entry = json.loads((self.v.root / "system/config/permissions-log.jsonl").read_text().splitlines()[-1])
        self.assertEqual((entry["via"], entry["why"], entry["op"]), ("dashboard", "to keep notes in the inbox", "add"))
        self.assertFalse(self.post("/api/permissions/edit", {"edit": pe["edit"]})[1]["ok"])      # one approval, one change
        self.assertTrue(self.post("/api/permissions/undo", {})[1]["ok"])
        self.assertNotIn("Write(inbox/notes/**)", self.allow())

    def test_two_edits_are_two_cards_each_applied_on_its_own(self):
        edits = [e for e in self.ask("two edits") if e["type"] == "permission_edit"]
        self.assertEqual(len(edits), 2)
        self.assertEqual(edits[1]["summary"].split(":")[0], "Change sweep.due_from in system/config/settings.json")
        self.assertTrue(self.post("/api/permissions/edit", {"edit": edits[0]["edit"]})[1]["ok"])
        cfg = self.v.root / "system/config/settings.json"
        self.assertNotEqual(json.loads(cfg.read_text())["sweep"]["due_from"], "06:30")           # the second is not covered by the first
        self.assertTrue(self.post("/api/permissions/edit", {"edit": edits[1]["edit"]})[1]["ok"])
        self.assertEqual(json.loads(cfg.read_text())["sweep"]["due_from"], "06:30")
        for _ in range(2):
            self.post("/api/permissions/undo", {})
        self.assertNotEqual(json.loads(cfg.read_text())["sweep"]["due_from"], "06:30")

    def test_the_page_cannot_apply_an_edit_no_run_asked_for_and_a_blanket_rule_is_refused(self):
        r = self.post("/api/permissions/edit", {"edit": "settings add allow Write(inbox/notes/**)"})[1]
        self.assertFalse(r["ok"])
        self.assertIn("Nothing asked for that edit", r["message"])
        pe = next(e for e in self.ask("bad edit") if e["type"] == "permission_edit")
        self.assertFalse(pe["ok"])
        self.assertFalse(self.post("/api/permissions/edit", {"edit": pe["edit"]})[1]["ok"])
        self.assertEqual(self.allow(), json.loads(self.original)["permissions"]["allow"])

    def test_a_refused_tool_is_shown(self):
        ev = self.ask("it was refused")
        denied = next(e for e in ev if e["type"] == "denied")
        self.assertIn("/tmp/build.js", denied["tools"][0])

    def test_the_panel_cannot_reach_its_own_settings_and_knows_the_protocol(self):
        flags = json.loads(next(e["text"] for e in self.ask("echo flags") if e["type"] == "text").replace("FLAGS ", ""))
        for rule in ("Edit(.claude/settings.json)", "Write(.claude/settings.json)", "Bash(python3 system/scripts/permissions.py*)"):
            self.assertIn(rule, flags["disallowed"])
        self.assertFalse([a for a in flags["allowed"] if "permissions.py" in a or ".claude" in a])
        self.assertIn("Bash(python3 system/scripts/report.py adhoc-data*)", flags["allowed"])    # it may look before it builds
        self.assertEqual(flags["prompt"], ["PERMISSION:", "cx-document", "CONFIRM:", "/tmp"])
        conf = self.ask("make a document of open actions")                                       # building a document is confirmed
        self.assertEqual(next(e for e in conf if e["type"] == "confirm")["title"], "Build the actions register")
        confirmed = json.loads(next(e["text"] for e in self.ask("echo flags", confirmed="Build the actions register") if e["type"] == "text").replace("FLAGS ", ""))
        self.assertIn("Bash(python3 system/scripts/report.py *)", confirmed["allowed"])
        self.assertFalse([a for a in confirmed["allowed"] if "permissions.py" in a])             # not even when confirmed


SCRIPT = r"""
<script>
(async()=>{ const out={errors:[]}, wait=ms=>new Promise(r=>setTimeout(r,ms)), el=id=>document.getElementById(id), sent=[];
  const real=window.fetch; window.fetch=async(u,o)=>{ if(u!=="/api/ask") return real(u,o); const body=JSON.parse(o.body); sent.push(body.message);
    const stream=new ReadableStream({start(c){ const enc=new TextEncoder(), send=e=>c.enqueue(enc.encode("data: "+JSON.stringify(e)+"\n\n"));
      if(body.message.startsWith("Permission added")){ send({type:"text",text:"Done: summaries saved."}); }
      else if(body.message.startsWith("The permission change")){ send({type:"text",text:"Done: notes kept."}); }
      else{ send({type:"text",text:"I can't save the summaries yet."}); if(window.__perm) send(window.__perm); for(const e of (window.__edits||[])) send(e); }
      send({type:"done",session:"sess-perm-1",chat:"sess-perm-1",run:body.run}); c.close(); }});
    return new Response(stream,{status:200,headers:{"Content-Type":"text/event-stream"}}); };
  const until=async(f,n=60)=>{ for(let i=0;i<n&&!f();i++) await wait(100); };
  try{
    await checkLive(); out.live=LIVE&&viaServer(); openChat();
    // a rule creaite will add: the card names it; Add the rule applies it and the request carries on
    window.__perm=window.__permOk; const first=send("save the summaries");      // not awaited: it waits for the click
    await until(()=>document.querySelector("#chLog .confirm")); const card=document.querySelector("#chLog .confirm");
    out.card=[card&&card.querySelector("b").textContent,card&&card.textContent.replace(/\s+/g," ").trim().slice(0,260),[...card.querySelectorAll("button")].map(b=>b.textContent)];
    card.querySelectorAll("button")[1].click(); await first; await until(()=>sent.length>1&&!BUSY);
    out.sent=sent.slice(); out.snack=el("snackT").textContent; out.undoShown=el("snackU").style.display!=="none";
    out.log=[...document.querySelectorAll("#chLog .msg")].map(m=>m.textContent.slice(0,45));
    // Cancel adds nothing
    sent.length=0; await until(()=>!BUSY); window.__perm=window.__permOk; const second=send("save the summaries again");
    await until(()=>document.querySelectorAll("#chLog .confirm").length>1); const cards=document.querySelectorAll("#chLog .confirm"); cards[cards.length-1].querySelectorAll("button")[0].click(); await second; await wait(300);
    out.cancelled=[sent.length,[...document.querySelectorAll("#chLog .step")].some(s=>s.textContent.includes("Permission not added"))];
    // a rule creaite won't add is explained and not offered
    window.__perm=window.__permBad; await until(()=>!BUSY); const before=document.querySelectorAll("#chLog .confirm").length; await send("build it with node");
    await wait(500); out.refusedCard=document.querySelectorAll("#chLog .confirm").length===before; out.refusedText=[...document.querySelectorAll("#chLog .msg.a")].pop().textContent;
    // BL-96: two permission-file edits are two cards; the first is made, the second cancelled; one continuation
    window.__perm=null; window.__edits=[window.__editA,window.__editB]; sent.length=0; await until(()=>!BUSY);
    const third=send("change my permissions");
    await until(()=>document.querySelectorAll("#chLog .confirm").length>=3); let cs=[...document.querySelectorAll("#chLog .confirm")];
    out.editCard=[cs[cs.length-1].querySelector("b").textContent,cs[cs.length-1].textContent.replace(/\s+/g," ").slice(0,300),[...cs[cs.length-1].querySelectorAll("button")].map(b=>b.textContent)];
    cs[cs.length-1].querySelectorAll("button")[1].click();
    await until(()=>document.querySelectorAll("#chLog .confirm").length>=4); cs=[...document.querySelectorAll("#chLog .confirm")];
    out.editCard2=cs[cs.length-1].querySelector("b").textContent; cs[cs.length-1].querySelectorAll("button")[0].click();
    await third; await until(()=>sent.length>1&&!BUSY); out.editSent=sent.slice();
    out.editSteps=[...document.querySelectorAll("#chLog .step")].map(x=>x.textContent).filter(x=>x.includes("not changed"));
  }catch(e){ out.errors.push(String(e&&e.stack||e)); }
  const pre=document.createElement("pre"); pre.id="result"; pre.textContent=JSON.stringify(out); document.body.appendChild(pre); })();
</script>
"""


@unittest.skipUnless(CHROME.exists(), "Google Chrome not installed")
class PermissionCardTests(unittest.TestCase):
    @classmethod
    def setUpClass(cls):
        cls.v = v = Vault()
        populate(v)
        fake = v.root / "fake_claude.py"
        fake.write_text(FAKE_CLAUDE)
        fake.chmod(0o755)
        ok = {"type": "permission", "rule": "Write(system/search/**)", "why": "to save search summaries", "ok": True, "reason": "", "covered": None}
        bad = {"type": "permission", "rule": "Bash(node build.js)", "why": "to build", "ok": False, "covered": None,
               "reason": "a Bash rule must run one creaite script"}
        edit_a = {"type": "permission_edit", "edit": "settings add allow Write(inbox/notes/**)", "why": "to keep notes in the inbox",
                  "ok": True, "reason": "", "summary": "Add Write(inbox/notes/**) to .claude/settings.json › permissions.allow", "diff": []}
        edit_b = {"type": "permission_edit", "edit": 'config set sweep.due_from "06:30"', "why": "Alan wants the sweep earlier",
                  "ok": True, "reason": "", "summary": 'Change sweep.due_from in system/config/settings.json: "07:00" → "06:30"', "diff": []}
        inject = v.root / "inject.html"
        inject.write_text(f"<script>window.__permOk={json.dumps(ok)};window.__permBad={json.dumps(bad)};"
                          f"window.__editA={json.dumps(edit_a)};window.__editB={json.dumps(edit_b)};</script>" + SCRIPT)
        port = free_port()
        env = {**os.environ, "CREAITE_PORT": str(port), "CREAITE_CLAUDE": str(fake), "CREAITE_TEST_INJECT": str(inject)}
        server = subprocess.Popen([sys.executable, str(v.root / "system/scripts/live_server.py")], env=env,
                                  stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        try:
            base = f"http://127.0.0.1:{port}"
            for _ in range(50):
                try:
                    urllib.request.urlopen(base + "/health", timeout=1)
                    break
                except OSError:
                    time.sleep(0.1)
            html = urllib.request.urlopen(base + "/").read().decode()
            token = json.loads(re.search(r'id="data">(.*?)</script>', html, re.S).group(1).replace("<\\/", "</"))["token"]
            req = urllib.request.Request(base + "/api/ask", data=json.dumps({"message": "need permission"}).encode(), method="POST",
                                         headers={"Content-Type": "application/json", "X-Creaite-Token": token})
            with urllib.request.urlopen(req, timeout=60) as r:           # a real run asks, so the server will accept the approval
                events(r)
            req = urllib.request.Request(base + "/api/ask", data=json.dumps({"message": "two edits"}).encode(), method="POST",
                                         headers={"Content-Type": "application/json", "X-Creaite-Token": token})
            with urllib.request.urlopen(req, timeout=60) as r:
                events(r)
            profile = tempfile.mkdtemp(prefix="creaite-chrome-")
            cmd = [str(CHROME), "--headless", "--disable-gpu", f"--user-data-dir={profile}", "--no-first-run",
                   "--disable-component-update", "--disable-background-networking", "--virtual-time-budget=30000",
                   "--dump-dom", base + "/"]
            try:
                out = subprocess.run(cmd, capture_output=True, timeout=90).stdout
            except subprocess.TimeoutExpired as e:
                out = e.stdout or b""
            shutil.rmtree(profile, ignore_errors=True)
        finally:
            server.terminate()
            server.wait(timeout=10)
        m = re.search(r'<pre id="result">(.*?)</pre>', out.decode("utf-8", "ignore"), re.S)
        assert m, "the page didn't finish the scripted steps"
        cls.r = json.loads(m.group(1).replace("&lt;", "<").replace("&gt;", ">").replace("&quot;", '"').replace("&amp;", "&"))

    @classmethod
    def tearDownClass(cls):
        cls.v.cleanup()

    def test_no_script_errors(self):
        self.assertEqual(self.r["errors"], [])
        self.assertTrue(self.r["live"])

    def test_the_card_names_the_rule_and_approving_applies_it_and_carries_on(self):
        r = self.r
        self.assertEqual(r["card"][0], "Allow Write(system/search/**)")
        self.assertIn("to save search summaries", r["card"][1])
        self.assertIn("backed up and logged", r["card"][1])
        self.assertEqual(r["card"][2], ["Cancel", "Add the rule"])
        settings = json.loads((self.v.root / ".claude/settings.json").read_text())["permissions"]["allow"]
        self.assertIn("Write(system/search/**)", settings)                                       # applied through the server
        self.assertEqual(r["sent"], ["save the summaries", "Permission added: Write(system/search/**). Carry on with my last request."])
        self.assertIn("Permission added: Write(system/search/**)", r["snack"])
        self.assertTrue(r["undoShown"])
        self.assertTrue(any(m.startswith("Done: summaries saved.") for m in r["log"]))

    def test_cancel_adds_nothing_and_a_refused_rule_is_only_explained(self):
        r = self.r
        self.assertEqual(r["cancelled"], [1, True])                                              # one request, no continuation
        self.assertTrue(r["refusedCard"])
        self.assertIn("which creaite won't add: a Bash rule must run one creaite script", r["refusedText"])
        self.assertIn("edit .claude/settings.json yourself in Terminal", r["refusedText"])

    def test_permission_file_edits_are_separate_cards_never_bulk(self):
        r = self.r
        self.assertEqual(r["editCard"][0], "Add Write(inbox/notes/**) to .claude/settings.json › permissions.allow")
        self.assertIn("changes a permission file, so it is confirmed on its own", r["editCard"][1])
        self.assertEqual(r["editCard"][2], ["Cancel", "Make this change"])                      # no "allow all"
        self.assertTrue(r["editCard2"].startswith("Change sweep.due_from"))
        allow = json.loads((self.v.root / ".claude/settings.json").read_text())["permissions"]["allow"]
        self.assertIn("Write(inbox/notes/**)", allow)                                           # the first, made through the server
        cfg = json.loads((self.v.root / "system/config/settings.json").read_text())
        self.assertNotEqual(cfg["sweep"]["due_from"], "06:30")                                  # the second was cancelled
        self.assertEqual(r["editSent"], ["The permission change is made. Carry on with my last request."])
        self.assertTrue(any("Permission file not changed" in x for x in r["editSteps"]), r["editSteps"])


if __name__ == "__main__":
    unittest.main()
